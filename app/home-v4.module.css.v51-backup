.home { position: relative; flex: 0 0 auto; width: 100%; background: #000; color: #fff; isolation: isolate; }
.stage { position: sticky; top: 0; width: 100%; height: 100svh; overflow: hidden; background: #000; }
.nav { position: absolute; inset: 0 0 auto; z-index: 50; padding: 25px 3vw; display: flex; justify-content: space-between; gap: 16px; font: 10px/1.5 Arial, sans-serif; letter-spacing: .09em; color: #aaa; }
.nav nav { display: flex; gap: 26px; }
.nav a { color: inherit; text-decoration: none; }
.nav a:hover { color: #fff; }
.stack { position: absolute; inset: 0; overflow: hidden; }
.categories { position: absolute; z-index: 50; top: 60px; left: 3vw; right: 3vw; display: flex; gap: 24px; flex-wrap: wrap; font: 11px/1.6 Arial, sans-serif; }
.categories a { color: #d4d4d4; text-decoration: none; padding: 4px 0; border-bottom: 1px solid transparent; text-shadow: 0 1px 4px #000; }
.categories a:hover { color: #fff; border-bottom-color: #fff; }
.artwork { position: absolute; left: 50%; top: 50%; width: 72vw; height: 68svh; display: block; background: #000; will-change: transform; transform-style: preserve-3d; backface-visibility: hidden; }
.artwork::before, .artwork::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: #0c0c0c; border: 1px solid #444; opacity: var(--leaf, 0); }
.artwork::before { transform: translateZ(-8px) translateY(5px); box-shadow: 0 3px #191919, 0 5px #555, 0 8px #151515, 0 10px #393939; }
.artwork::after { transform: translateZ(-17px) translateY(12px); box-shadow: 0 3px #343434, 0 5px #111, 0 7px #414141; }
.artwork img { position: relative; display: block; width: 100%; height: 100%; object-fit: contain; user-select: none; transform: translateZ(1px); }
.title { position: absolute; z-index: 40; left: 50%; top: 43%; transform: translate(-50%, -50%); margin: 0; padding: 0; width: max-content; max-width: 94%; font-family: var(--font-v4-inika), Georgia, 'Times New Roman', serif; font-weight: 400; font-size: min(10vw, 18svh); line-height: .96; letter-spacing: .008em; text-align: center; color: #fff; pointer-events: none; -webkit-text-stroke-color: #fff; }
.title span { display: block; white-space: nowrap; }
.footer { position: absolute; z-index: 45; inset: auto 3vw 25px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 20px; font: 10px/1.5 Arial, sans-serif; letter-spacing: .04em; }
.caption { max-width: 230px; text-transform: uppercase; color: #ccc; }
.tags { display: flex; gap: 22px; }
.tags span { animation: arrive 360ms both; color: #ff7953; white-space: nowrap; }
.tags span::before { content: ''; display: inline-block; width: 5px; height: 5px; margin: 0 7px 1px 0; background: currentColor; border-radius: 50%; }
.tags span:nth-child(2) { color: #a8f76b; }
.tags span:nth-child(3) { color: #c6acff; }
.controls { justify-self: end; display: flex; align-items: center; gap: 16px; font-variant-numeric: tabular-nums; white-space: nowrap; }
.controls button { font: inherit; font-size: 16px; color: #fff; padding: 8px; margin: -8px 0; border: 0; background: transparent; cursor: pointer; }
.controls button:disabled { opacity: .22; cursor: default; }
.home a:focus-visible, .home button:focus-visible { outline: 1px solid #fff; outline-offset: 5px; }
@keyframes arrive { from { opacity: 0; transform: translateY(7px); } to { opacity: 1; transform: translateY(0); } }
@media (max-width: 700px) {
  .nav { padding: 22px 5vw; font-size: 9px; } .nav nav { gap: 16px; }
  .artwork { width: 86vw; }
  .categories { top: 53px; left: 5vw; right: 5vw; gap: 8px 16px; font-size: 10px; }
  .footer { left: 5vw; right: 5vw; bottom: 22px; grid-template-columns: 1fr auto; gap: 14px; }
  .caption { grid-column: 1; font-size: 9px; } .tags { grid-row: 2; grid-column: 1 / -1; gap: 16px; font-size: 9px; }
  .controls { grid-row: 1; grid-column: 2; gap: 7px; }
}
@media (prefers-reduced-motion: reduce) { .tags span { animation: none; } .artwork { will-change: auto; } }

/* Local custom typeface. Frost is clipped to actual live SVG glyphs, not a rectangle. */
.glassTitle { width: 92vw; max-width: 92vw; height: 24vw; color: rgba(255,255,255,.3); -webkit-text-stroke: 0; }
.glyphs { position: absolute; inset: 0; overflow: visible; font: inherit; letter-spacing: inherit; pointer-events: none; }
.glyphs text { fill: rgba(255,255,255,.24); stroke: rgba(255,255,255,.78); stroke-width: var(--glass-edge, .6px); paint-order: stroke fill; }
.glassPane { position: absolute; inset: 0; background: rgba(255,255,255,.14); backdrop-filter: blur(9px) saturate(1.55); -webkit-backdrop-filter: blur(9px) saturate(1.55); pointer-events: none; }
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .glyphs text { fill: rgba(255,255,255,.56); } }
@media (forced-colors: active) { .glassPane { display: none; } .glyphs text { fill: CanvasText; stroke: none; } }
